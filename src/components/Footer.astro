---
import { contactEmail, contactEmailParts, type Content } from '../i18n/content';

interface Props {
  t: Content;
}
const { t } = Astro.props;
const home = t.lang === 'ja' ? '/ja/' : '/';
const links = [
  { href: `${home}#services`, label: t.nav.services },
  { href: `${home}#work`, label: t.nav.work },
  { href: `${home}#process`, label: t.nav.process },
  { href: `${home}#about`, label: t.nav.about },
  { href: t.footer.privacyHref, label: t.footer.privacy },
  { href: t.footer.creditsHref, label: t.footer.credits },
];
---

<!-- The close: the last rows of the board, every tile filled, the name at full width. -->
<footer class="footer">
  <div class="board">
    <div class="tile statement">
      <p class="phrased">{t.footer.statement}</p>
      <p class="small">{t.footer.legalName}<br />{t.footer.address}<br />{t.footer.rights}</p>
    </div>
    <nav class="tile links" aria-label={t.lang === 'ja' ? 'サイト' : 'Site'}>
      <ul>
        {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        <li><a href={t.nav.switchHref} hreflang={t.nav.switchLang} lang={t.nav.switchLang}>{t.nav.switchLabel}</a></li>
      </ul>
    </nav>
    <div class="tile place">
      <p class="lead">{t.footer.place}</p>
      <p class="small"><time data-clock>JST</time> {t.footer.timeLabel}</p>
    </div>
    <div class="tile email">
      <span class="envelope" aria-hidden="true">
        <svg viewBox="0 0 256 256" focusable="false"><path class="shut" d="M224,48H32a8,8,0,0,0-8,8V192a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V56A8,8,0,0,0,224,48Zm-96,85.15L52.57,64H203.43ZM98.71,128,40,181.81V74.19Zm11.84,10.85,12,11.05a8,8,0,0,0,10.82,0l12-11.05,58,53.15H52.57ZM157.29,128,216,74.18V181.82Z" /><path class="open" transform="translate(0 -8)" d="M228.44,89.34l-96-64a8,8,0,0,0-8.88,0l-96,64A8,8,0,0,0,24,96V200a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V96A8,8,0,0,0,228.44,89.34ZM96.72,152,40,192V111.53Zm16.37,8h29.82l56.63,40H56.46Zm46.19-8L216,111.53V192ZM128,41.61l81.91,54.61-67,47.78H113.11l-67-47.78Z" /></svg>
      </span>
      <a href={`mailto:${contactEmail}`}>{contactEmailParts.map((part, i) => <>{i > 0 && <wbr />}{part}</>)}</a>
    </div>

    <!-- Both drums print the mast: the pink plate is drawn underneath, a hair out of register. -->
    <div class="tile mast" aria-hidden="true">
      <span class="mark">
        <svg viewBox="0 0 24 24" focusable="false">
          <path class="mark-pink" d="M12 0C13 8 16 11 24 12C16 13 13 16 12 24C11 16 8 13 0 12C8 11 11 8 12 0Z" />
          <path class="mark-paper" d="M12 0C13 8 16 11 24 12C16 13 13 16 12 24C11 16 8 13 0 12C8 11 11 8 12 0Z" />
        </svg>
        <span class="word" data-text="funkel labs">funkel labs</span>
      </span>
    </div>
    <a class="tile start" href={`${home}#contact`}>
      <span class="lead">{t.footer.start}</span>
      <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path d="M10 38 38 10M16 10h22v22" /></svg>
    </a>
  </div>
</footer>

<script>
  // The studio's local time, in Japan.
  const clock = document.querySelector<HTMLTimeElement>('[data-clock]');
  if (clock) {
    const format = new Intl.DateTimeFormat(document.documentElement.lang === 'ja' ? 'ja-JP' : 'en-GB', {
      hour: '2-digit',
      minute: '2-digit',
      timeZone: 'Asia/Tokyo',
    });
    const tick = () => {
      clock.textContent = format.format(new Date());
    };
    tick();
    setInterval(tick, 30_000);
  }
</script>

<style>
  .footer {
    background-color: var(--color-paper);
    padding: var(--gutter);
  }

  .board {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 8px;
  }

  .tile {
    margin: 0;
    padding: 24px;
    min-height: 220px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    background-color: var(--color-paper-2);
    color: var(--color-pink-ink);
  }

  .lead {
    font-size: var(--step-lead);
    line-height: 1.25;
  }

  .small {
    font-size: var(--step-small);
  }

  .statement {
    grid-column: span 4;
  }

  .links {
    grid-column: span 3;
    background-color: var(--color-ink-5);
  }

  .links ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 4px;
  }

  .place {
    grid-column: span 2;
    background-color: var(--color-paper-3);
  }

  .email {
    grid-column: span 3;
    background-color: var(--color-ink-4);
  }

  /* Printed in the two drums like the rest of the board: the pink drum lays the envelope's fill,
     the ink sets its key line multiplied over it, a hair out of register. */
  .envelope {
    position: relative;
    display: block;
    width: 64px;
    height: 64px;
  }

  /* The fill plate, with the grain the board's other pink fields carry; set on the icon's 256-unit grid, 8 units off register.
     Its box holds the opened envelope; the clip cuts it to the shut one, and opening raises the flap's point. */
  .envelope::before {
    content: "";
    position: absolute;
    left: calc(32 / 256 * 100%);
    top: calc(25 / 256 * 100%);
    width: calc(208 / 256 * 100%);
    height: calc(191 / 256 * 100%);
    background-color: var(--color-pink);
    background-image: var(--grain);
    clip-path: polygon(0 16.2%, 50% 16.2%, 100% 16.2%, 100% 100%, 0 100%);
  }

  .envelope .open {
    opacity: 0;
  }

  /* Hovering the tile, or focusing its address, opens the envelope. */
  .email:is(:hover, :focus-within) .envelope::before {
    clip-path: polygon(0 37.2%, 50% 0, 100% 37.2%, 100% 100%, 0 100%);
  }

  .email:is(:hover, :focus-within) .envelope .shut {
    opacity: 0;
  }

  .email:is(:hover, :focus-within) .envelope .open {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .envelope::before {
      transition: clip-path 200ms var(--ease-out);
    }

    .envelope path {
      transition: opacity 100ms linear;
    }

    .email:is(:hover, :focus-within) .envelope::before {
      transition-duration: 320ms;
    }

    .email:is(:hover, :focus-within) .envelope .open {
      transition: opacity 160ms linear 80ms;
    }
  }

  .envelope svg {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    fill: currentColor;
    mix-blend-mode: multiply;
  }

  .email a {
    overflow-wrap: anywhere;
  }

  .mast {
    grid-column: span 8;
    min-height: 320px;
    display: grid;
    place-items: center;
    background-color: var(--color-ink);
    font-size: var(--step-display);
    isolation: isolate;
  }

  .mark {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-wordmark);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    white-space: nowrap;
    color: var(--color-on-ink);
  }

  .mark svg {
    width: 0.95em;
    height: 0.95em;
    overflow: visible;
  }

  .mark-pink {
    fill: var(--color-pink);
    transform: translate(0.9px, 0.75px);
  }

  .mark-paper {
    fill: var(--color-on-ink);
  }

  .word {
    position: relative;
    isolation: isolate;
  }

  .word::before {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    z-index: -1;
    color: var(--color-pink);
    transform: translate(0.035em, 0.03em);
  }

  .start {
    grid-column: span 4;
    min-height: 320px;
    background-color: var(--color-pink);
    background-image: var(--grain);
    color: var(--color-pink-ink);
    text-decoration: none;
    transition: background-color 200ms var(--ease-out);
  }

  .start .lead {
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: var(--tracking-display);
  }

  .start svg {
    align-self: flex-end;
    width: 64px;
    height: 64px;
    fill: none;
    stroke: currentColor;
    stroke-width: 4;
    transition: transform 240ms var(--ease-out);
  }

  .start:hover {
    background-color: var(--color-paper-3);
  }

  .start:hover svg {
    transform: translate(6px, -6px);
  }

  /* As the footer scrolls in, the pink plate travels toward register, tied to scroll position. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      /* Longhands on purpose: the `animation` shorthand cannot carry a timeline. */
      .word::before {
        animation-name: mast-register;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 0% cover 50%;
      }
    }
  }

  @keyframes mast-register {
    from {
      transform: translate(0.2em, 0.16em);
    }
    to {
      transform: translate(0.035em, 0.03em);
    }
  }

  /* Tablets: the four small tiles pair up, so the place and email tiles are not squeezed to a sliver. */
  @media (max-width: 1023px) {
    .statement,
    .links,
    .place,
    .email {
      grid-column: span 6;
    }
  }

  @media (max-width: 760px) {

    .board {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 6px;
    }

    .tile {
      padding: 20px;
      min-height: 160px;
    }

    .mast,
    .start {
      grid-column: 1 / -1;
      min-height: 160px;
    }

    .mast {
      order: -2;
      font-size: 12vw;
    }

    .start {
      order: -1;
    }

    /* The statement and email run the full width; links and place share a row. */
    .statement,
    .email {
      grid-column: 1 / -1;
    }

    .links,
    .place {
      grid-column: span 1;
    }
  }
</style>
