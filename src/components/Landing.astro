---
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import Services from './Services.astro';
import Work from './Work.astro';
import Process from './Process.astro';
import About from './About.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import { content, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}
const t = content[Astro.props.lang];
---

<Base lang={t.lang} title={t.meta.title} description={t.meta.description} path="/">
  <a class="skip-link" href="#main">{t.lang === 'ja' ? '本文へ移動' : 'Skip to content'}</a>
  <Nav t={t} />
  <main id="main">
    <Hero t={t} />
    <Services t={t} />
    <Work t={t} />
    <Process t={t} />
    <About t={t} />
    <Contact t={t} />
  </main>
  <Footer t={t} />
</Base>

<script>
  import { armEntrances } from '../scripts/rise';

  armEntrances();
</script>
