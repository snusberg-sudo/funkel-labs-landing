---
import { Image } from 'astro:assets';
import type { Content } from '../i18n/content';
import { picture } from '../scripts/pictures';

interface Props {
  t: Content;
}
const { t } = Astro.props;
const spark = 'M12 0C13 8 16 11 24 12C16 13 13 16 12 24C11 16 8 13 0 12C8 11 11 8 12 0Z';
// Card panels rotate through screens of the two drums at a similar lightness.
const tones = ['tone-stock', 'tone-pink', 'tone-blue'];
---

<!--
  Chapter three, the press room: a press runs in the blue drum behind the work,
  and each app passes across it like a sheet coming off the rollers. Pinned on
  desktop; a plain stack on phones and with reduced motion.
-->
<section id="work" class="work" data-showcase aria-labelledby="work-title">
  <div class="stage">
    <div class="wrap intro" data-chapter>
      <h2 id="work-title" data-rise>{t.work.heading}</h2>
      <p data-rise style="--rise: 1" class="phrased">{t.work.lede}</p>
    </div>

    <!-- The bed: the press runs here, below the heading, and the cards cross it inside the page margins. -->
    <div class="bed">
      <div class="ground" aria-hidden="true">
        <video muted loop playsinline autoplay preload="metadata" poster="/found/press-run-poster.jpg" width="854" height="480" data-press>
          <source src="/found/press-run.webm" type="video/webm" />
        </video>
      </div>
      <div class="rail">
    <ul class="track" data-track>
      {t.work.apps.map((app, i) => (
        <li class:list={['card', tones[i % tones.length]]}>
          <div class="shot">
            {app.image ? (
              <Image src={picture(app.image)} alt={app.imageAlt} widths={[640, 960, 1440]} sizes="(max-width: 760px) 90vw, 40vw" />
            ) : (
              // TODO: stand-in plate until the app's own screenshot arrives (see README).
              <svg viewBox="0 0 320 200" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
                <rect x="96" y="18" width="128" height="230" rx="16" class="ink-line" />
                <path d={spark} transform={`translate(124 ${44 + i * 4}) scale(3)`} class="pink-fill" />
                <path d={spark} transform={`translate(127 ${47 + i * 4}) scale(3)`} class="ink-fill" />
                <rect x="116" y="138" width="88" height="8" class="ink-fill" />
                <rect x="116" y="154" width="64" height="8" class="ink-fill" />
                <rect x="116" y="176" width="88" height="22" class="pink-fill" />
              </svg>
            )}
          </div>
          <div class="panel">
            <h3>{app.name}</h3>
            <div class="meta">
              <p>{app.platform}</p>
              <p>{app.body}</p>
              {app.link?.href && <a href={app.link.href}>{app.link.label}</a>}
            </div>
          </div>
        </li>
      ))}
    </ul>
      </div>
    </div>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>('[data-showcase]');
  const track = section?.querySelector<HTMLElement>('[data-track]');
  const video = section?.querySelector<HTMLVideoElement>('[data-press]');
  const motion = window.matchMedia('(prefers-reduced-motion: no-preference)');
  const pinned = window.matchMedia('(min-width: 1024px) and (prefers-reduced-motion: no-preference)');

  // The press runs only while it is on screen, and never under reduced motion.
  if (section && video) {
    const sync = (visible: boolean) => {
      if (visible && motion.matches) void video.play().catch(() => undefined);
      else video.pause();
    };
    if (!motion.matches) video.pause();
    new IntersectionObserver(([entry]) => sync(entry?.isIntersecting ?? false)).observe(section);
  }

  // Scroll carries the cards across the held press, right to left.
  if (section && track) {
    const rail = track.parentElement as HTMLElement;
    const stage = section.firstElementChild as HTMLElement;
    const cards = [...track.children] as HTMLElement[];
    let travel = 0;
    let width = 0;
    let span = 0;
    let shift = 0;
    let edges: { left: number; right: number }[] = [];

    // Layout is read only here, so each scroll frame is one read and then writes.
    const measure = () => {
      if (!pinned.matches) {
        section.style.removeProperty('--travel');
        track.style.removeProperty('transform');
        for (const card of cards) card.classList.remove('is-out');
        travel = 0;
        return;
      }
      width = rail.clientWidth;
      travel = Math.max(0, track.scrollWidth - width);
      section.style.setProperty('--travel', `${travel}px`);
      span = section.offsetHeight - stage.offsetHeight;
      const origin = rail.getBoundingClientRect().left + shift;
      edges = cards.map((card) => {
        const box = card.getBoundingClientRect();
        return { left: box.left - origin, right: box.right - origin };
      });
      update();
    };

    const update = () => {
      if (!travel) return;
      const top = section.getBoundingClientRect().top;
      const progress = span > 0 ? Math.min(1, Math.max(0, -top / span)) : 0;
      shift = -progress * travel;
      track.style.transform = `translate3d(${shift.toFixed(1)}px, 0, 0)`;
      // A card's caption prints only once the whole card is inside the margins.
      cards.forEach((card, index) => {
        const edge = edges[index];
        card.classList.toggle('is-out', edge.right + shift > width + 1 || edge.left + shift < -1);
      });
    };

    let queued = false;
    const queue = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          update();
        });
      }
    };
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('jumpframe', update);
    new ResizeObserver(measure).observe(track);
    window.addEventListener('resize', measure);
    pinned.addEventListener('change', measure);
    measure();
  }
</script>

<style>
  .work {
    --travel: 0px;
    position: relative;
    color: var(--color-on-ink);
    background-color: var(--color-pink-ink);
  }

  .stage {
    position: relative;
    overflow: hidden;
    padding-top: clamp(72px, 12vh, 140px);
  }

  .bed {
    position: relative;
    padding-block: clamp(32px, 6vh, 64px);
  }

  .rail {
    position: relative;
    margin-inline: var(--gutter);
    overflow: clip;
  }

  /* The press, printed in the blue drum: dark tones deep blue, light tones a lighter screen. */
  .ground {
    position: absolute;
    inset: 0;
    background-color: var(--color-ink-3);
    isolation: isolate;
  }

  .ground video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.15);
    mix-blend-mode: multiply;
  }

  .ground::after {
    content: "";
    position: absolute;
    inset: 0;
    background-color: var(--color-pink-ink);
    mix-blend-mode: lighten;
  }

  .intro {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    column-gap: clamp(16px, 2.2vw, 32px);
    align-items: end;
    padding-bottom: clamp(32px, 5vh, 56px);
  }

  h2 {
    font-size: var(--step-heading);
    line-height: 1;
  }

  .intro p {
    font-size: var(--step-lead);
    line-height: 1.3;
    max-width: 26ch;
  }

  :lang(ja) .intro p {
    max-width: 18em;
  }

  .track {
    position: relative;
    display: flex;
    gap: 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    flex: none;
    width: min(600px, 44vw);
    aspect-ratio: 720 / 560;
    display: grid;
    grid-template-rows: 68fr 32fr;
    color: var(--color-pink-ink);
  }

  .shot {
    overflow: hidden;
    background-color: var(--color-paper-3);
    background-image: var(--grain);
  }

  .shot img,
  .shot svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .shot svg {
    isolation: isolate;
  }

  .ink-line {
    fill: none;
    stroke: var(--color-ink);
    stroke-width: 4;
  }

  .ink-fill {
    fill: var(--color-ink);
    mix-blend-mode: multiply;
  }

  .pink-fill {
    fill: var(--color-pink);
    mix-blend-mode: multiply;
  }

  .panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: end;
    gap: 16px;
    padding: 28px;
  }

  .tone-stock .panel {
    background-color: var(--color-paper);
  }

  .tone-pink .panel {
    background-color: var(--color-paper-2);
  }

  .tone-blue .panel {
    background-color: var(--color-ink-5);
  }

  h3 {
    font-size: var(--step-lead);
    line-height: 1.05;
  }

  .meta {
    justify-self: end;
    text-align: right;
    display: grid;
    gap: 2px;
    font-size: var(--step-body);
    line-height: 1.4;
  }

  .panel > * {
    transition: opacity 260ms var(--ease-out), visibility 0s;
  }

  .card:global(.is-out) .panel > * {
    opacity: 0;
    visibility: hidden;
    transition: opacity 200ms var(--ease-out), visibility 0s linear 200ms;
  }

  .meta p:first-child {
    font-weight: 600;
  }

  .meta a {
    justify-self: end;
    margin-top: 4px;
  }

  /* Pinned on desktop: the stage holds while the cards cross it. */
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .work {
      height: calc(100svh + var(--travel));
    }

    .stage {
      position: sticky;
      top: 0;
      height: 100svh;
      display: flex;
      flex-direction: column;
      padding-top: 96px;
    }

    .bed {
      flex: 1;
      display: flex;
      align-items: center;
    }

    .rail {
      flex: 1;
      min-width: 0;
    }

    .track {
      padding-left: 12%;
      will-change: transform;
    }
  }

  /* Phones and reduced motion: the press as a band, the cards stacked. */
  @media (max-width: 1023px), (prefers-reduced-motion: reduce) {
    .track {
      flex-wrap: wrap;
      gap: 24px;
    }

    .card {
      width: 100%;
      aspect-ratio: auto;
      grid-template-rows: auto auto;
    }

    .shot {
      aspect-ratio: 4 / 3;
    }

    .panel {
      grid-template-columns: minmax(0, 1fr);
      padding: 20px;
    }

    .meta {
      justify-self: start;
      text-align: left;
    }

    .meta a {
      justify-self: start;
    }

    .intro {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 16px;
    }
  }

  @media (min-width: 640px) and (max-width: 1023px), (min-width: 640px) and (prefers-reduced-motion: reduce) {
    .card {
      width: calc(50% - 12px);
    }
  }
</style>
