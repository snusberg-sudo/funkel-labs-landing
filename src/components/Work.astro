---
import { Image } from 'astro:assets';
import type { Content } from '../i18n/content';
import { picture } from '../scripts/pictures';

interface Props {
  t: Content;
}
const { t } = Astro.props;
const spark = 'M12 0C13 8 16 11 24 12C16 13 13 16 12 24C11 16 8 13 0 12C8 11 11 8 12 0Z';
// Card panels rotate through screens of the two drums at a similar lightness.
const tones = ['tone-stock', 'tone-pink', 'tone-blue'];
---

<!--
  Chapter three, the press room: a press runs in the blue drum behind the work,
  and each app passes across it like a sheet coming off the rollers. Pinned on
  desktop; a plain stack on phones and with reduced motion.
-->
<section id="work" class="work" data-showcase aria-labelledby="work-title">
  <div class="stage">
    <div class="wrap intro" data-chapter>
      <h2 id="work-title" data-rise>{t.work.heading}</h2>
      <p data-rise style="--rise: 1" class="phrased">{t.work.lede}</p>
    </div>

    <!-- The bed: the press runs here, below the heading, and the cards cross it inside the page margins. -->
    <div class="bed">
      <div class="ground" aria-hidden="true">
        <video muted loop playsinline autoplay preload="metadata" poster="/found/press-run-poster.jpg" width="854" height="480" data-press>
          <source src="/found/press-run.webm" type="video/webm" />
        </video>
      </div>
      <div class="rail">
    <ul class="track" data-track>
      {t.work.apps.map((app, i) => (
        <li class:list={['card', tones[i % tones.length]]}>
          <div class="shot">
            {app.image ? (
              <Fragment>
                {/* Two separations of the screenshot, pink then blue, that print it before full colour comes through. */}
                <span class="plate plate-pink" aria-hidden="true"><Image src={picture(app.image)} alt="" widths={[640, 960, 1440]} sizes="(max-width: 760px) 90vw, 40vw" /></span>
                <span class="plate plate-blue" aria-hidden="true"><Image src={picture(app.image)} alt="" widths={[640, 960, 1440]} sizes="(max-width: 760px) 90vw, 40vw" /></span>
                <Image class="full" src={picture(app.image)} alt={app.imageAlt} widths={[640, 960, 1440]} sizes="(max-width: 760px) 90vw, 40vw" />
              </Fragment>
            ) : (
              // An unprinted plate: the open slot for the visitor's app, or any app still without a screenshot.
              <svg viewBox="0 0 320 200" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
                <rect x="96" y="18" width="128" height="230" rx="16" class="ink-line" />
                <path d={spark} transform={`translate(124 ${44 + i * 4}) scale(3)`} class="pink-fill" />
                <path d={spark} transform={`translate(127 ${47 + i * 4}) scale(3)`} class="ink-fill" />
                <rect x="116" y="138" width="88" height="8" class="ink-fill" />
                <rect x="116" y="154" width="64" height="8" class="ink-fill" />
                <rect x="116" y="176" width="88" height="22" class="pink-fill" />
              </svg>
            )}
          </div>
          <div class="panel">
            <h3>{app.name}</h3>
            <div class="meta">
              {app.platform && <p>{app.platform}</p>}
              <p>{app.body}</p>
              {app.link?.href && <a href={app.link.href}>{app.link.label}</a>}
            </div>
          </div>
        </li>
      ))}
    </ul>
      </div>
    </div>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>('[data-showcase]');
  const track = section?.querySelector<HTMLElement>('[data-track]');
  const video = section?.querySelector<HTMLVideoElement>('[data-press]');
  const motion = window.matchMedia('(prefers-reduced-motion: no-preference)');
  const pinned = window.matchMedia('(min-width: 1024px) and (prefers-reduced-motion: no-preference)');

  // The press runs only while it is on screen, and never under reduced motion.
  if (section && video) {
    const sync = (visible: boolean) => {
      if (visible && motion.matches) void video.play().catch(() => undefined);
      else video.pause();
    };
    if (!motion.matches) video.pause();
    new IntersectionObserver(([entry]) => sync(entry?.isIntersecting ?? false)).observe(section);
  }

  // Each card prints once, the first time it is well on screen and inside the margins.
  if (section && track && motion.matches) {
    section.dataset.armed = '';
    const seen = new Set<Element>();
    const print = (card: Element) => {
      if (seen.has(card) && !card.classList.contains('is-out')) card.classList.add('printed');
    };
    const watch = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) seen.add(entry.target);
        print(entry.target);
      }
    }, { threshold: 0.6 });
    for (const card of track.children) watch.observe(card);
    window.addEventListener('cardsmoved', () => seen.forEach(print));
  }

  // Scroll carries the cards across the held press, right to left.
  if (section && track) {
    const rail = track.parentElement as HTMLElement;
    const stage = section.firstElementChild as HTMLElement;
    const cards = [...track.children] as HTMLElement[];
    let travel = 0;
    let width = 0;
    let span = 0;
    let shift = 0;
    let edges: { left: number; right: number }[] = [];

    // Layout is read only here, so each scroll frame is one read and then writes.
    const measure = () => {
      if (!pinned.matches) {
        section.style.removeProperty('--travel');
        track.style.removeProperty('transform');
        for (const card of cards) card.classList.remove('is-out');
        travel = 0;
        return;
      }
      width = rail.clientWidth;
      travel = Math.max(0, track.scrollWidth - width);
      section.style.setProperty('--travel', `${travel}px`);
      span = section.offsetHeight - stage.offsetHeight;
      const origin = rail.getBoundingClientRect().left + shift;
      edges = cards.map((card) => {
        const box = card.getBoundingClientRect();
        return { left: box.left - origin, right: box.right - origin };
      });
      update();
    };

    const update = () => {
      if (!travel) return;
      const top = section.getBoundingClientRect().top;
      const progress = span > 0 ? Math.min(1, Math.max(0, -top / span)) : 0;
      shift = -progress * travel;
      track.style.transform = `translate3d(${shift.toFixed(1)}px, 0, 0)`;
      // A card's caption prints only once the whole card is inside the margins.
      cards.forEach((card, index) => {
        const edge = edges[index];
        card.classList.toggle('is-out', edge.right + shift > width + 1 || edge.left + shift < -1);
      });
      window.dispatchEvent(new Event('cardsmoved'));
    };

    let queued = false;
    const queue = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          update();
        });
      }
    };
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('jumpframe', update);
    new ResizeObserver(measure).observe(track);
    window.addEventListener('resize', measure);
    pinned.addEventListener('change', measure);
    measure();
  }
</script>

<style>
  .work {
    --travel: 0px;
    position: relative;
    color: var(--color-on-ink);
    background-color: var(--color-pink-ink);
  }

  .stage {
    position: relative;
    overflow: hidden;
    padding-top: clamp(72px, 12vh, 140px);
  }

  .bed {
    position: relative;
    padding-block: clamp(32px, 6vh, 64px);
  }

  .rail {
    position: relative;
    margin-inline: var(--gutter);
    overflow: clip;
  }

  /* The press, printed in the blue drum: dark tones deep blue, light tones a lighter screen. */
  .ground {
    position: absolute;
    inset: 0;
    background-color: var(--color-ink-3);
    isolation: isolate;
  }

  .ground video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.15);
    mix-blend-mode: multiply;
  }

  .ground::after {
    content: "";
    position: absolute;
    inset: 0;
    background-color: var(--color-pink-ink);
    mix-blend-mode: lighten;
  }

  .intro {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    column-gap: clamp(16px, 2.2vw, 32px);
    align-items: end;
    padding-bottom: clamp(32px, 5vh, 56px);
  }

  h2 {
    font-size: var(--step-heading);
    line-height: 1;
  }

  .intro p {
    font-size: var(--step-lead);
    line-height: 1.3;
    max-width: 26ch;
  }

  :lang(ja) .intro p {
    max-width: 18em;
  }

  .track {
    position: relative;
    display: flex;
    gap: 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    flex: none;
    width: min(600px, 44vw);
    aspect-ratio: 720 / 560;
    display: grid;
    grid-template-rows: 68fr 32fr;
    color: var(--color-pink-ink);
  }

  .shot {
    overflow: hidden;
    background-color: var(--color-paper-3);
    background-image: var(--grain);
  }

  .shot img,
  .shot svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .shot svg {
    isolation: isolate;
  }

  /*
    The two-pass print. A screenshot prints as two separations of itself: the pink plate lands well
    off register, the blue plate strikes over it (multiplied, so they overprint purple), both pull into
    register, and the full-colour screenshot comes through. The plates exist only once the script arms
    the section, so without script or motion the screenshot simply stands.
  */
  .shot {
    position: relative;
  }

  .plate {
    display: none;
    position: absolute;
    inset: 0;
    background-color: var(--color-paper);
    isolation: isolate;
  }

  .plate img {
    filter: grayscale(1) contrast(1.25);
    mix-blend-mode: multiply;
  }

  .plate::after {
    content: "";
    position: absolute;
    inset: 0;
    background-color: var(--color-pink);
    mix-blend-mode: lighten;
  }

  .plate-blue {
    mix-blend-mode: multiply;
  }

  .plate-blue::after {
    background-color: var(--color-ink);
  }

  .work[data-armed] .shot:has(.plate) {
    background-color: var(--color-paper);
    background-image: none;
  }

  .work[data-armed] .plate {
    display: block;
    opacity: 0;
  }

  .work[data-armed] .shot .full {
    position: relative;
    opacity: 0;
  }

  .work[data-armed] .card:not(:global(.printed)) .panel > * {
    opacity: 0;
  }

  .work[data-armed] :global(.printed) .plate-pink {
    animation: plate-pink 1400ms both;
  }

  .work[data-armed] :global(.printed) .plate-blue {
    animation: plate-blue 1400ms both;
  }

  .work[data-armed] :global(.printed) .full {
    animation: full-colour 1400ms both;
  }

  /* The caption stamps on once the sheet is printed; on the unprinted plate, straight away. */
  .work[data-armed] :global(.printed) .panel > * {
    animation: stamp 260ms var(--ease-out) both;
    animation-delay: 1300ms;
  }

  .work[data-armed] :global(.printed) .panel > .meta {
    animation-delay: 1370ms;
  }

  .work[data-armed] :global(.printed) .shot:not(:has(.plate)) ~ .panel > * {
    animation-delay: 120ms;
  }

  .work[data-armed] :global(.printed) .shot:not(:has(.plate)) ~ .panel > .meta {
    animation-delay: 190ms;
  }

  @keyframes plate-pink {
    0% { opacity: 0; transform: translate(9%, 5%); animation-timing-function: var(--ease-out); }
    22% { opacity: 1; transform: translate(3.6%, 5%); }
    40% { transform: translate(3.6%, 5%); animation-timing-function: var(--ease-out); }
    82%, 100% { opacity: 1; transform: none; }
  }

  @keyframes plate-blue {
    0%, 28% { opacity: 0; transform: translate(-1.7%, -2.4%) scale(1.04); animation-timing-function: var(--ease-out); }
    40% { opacity: 1; transform: translate(-1.7%, -2.4%); animation-timing-function: var(--ease-out); }
    82%, 100% { opacity: 1; transform: none; }
  }

  @keyframes full-colour {
    0%, 78% { opacity: 0; }
    96%, 100% { opacity: 1; }
  }

  @keyframes stamp {
    from { opacity: 0; transform: scale(1.12) rotate(-2deg); }
    to { opacity: 1; transform: none; }
  }

  .ink-line {
    fill: none;
    stroke: var(--color-ink);
    stroke-width: 4;
  }

  .ink-fill {
    fill: var(--color-ink);
    mix-blend-mode: multiply;
  }

  .pink-fill {
    fill: var(--color-pink);
    mix-blend-mode: multiply;
  }

  .panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: end;
    gap: 16px;
    padding: 28px;
  }

  .tone-stock .panel {
    background-color: var(--color-paper);
  }

  .tone-pink .panel {
    background-color: var(--color-paper-2);
  }

  .tone-blue .panel {
    background-color: var(--color-ink-5);
  }

  h3 {
    font-size: var(--step-lead);
    line-height: 1.05;
  }

  .meta {
    justify-self: end;
    text-align: right;
    display: grid;
    gap: 2px;
    font-size: var(--step-body);
    line-height: 1.4;
  }

  .panel > * {
    transition: opacity 260ms var(--ease-out), visibility 0s;
  }

  .card:global(.is-out) .panel > * {
    opacity: 0;
    visibility: hidden;
    transition: opacity 200ms var(--ease-out), visibility 0s linear 200ms;
  }

  .meta p:first-child {
    font-weight: 600;
  }

  .meta a {
    justify-self: end;
    margin-top: 4px;
  }

  /* Pinned on desktop: the stage holds while the cards cross it. */
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .work {
      height: calc(100svh + var(--travel));
    }

    .stage {
      position: sticky;
      top: 0;
      height: 100svh;
      display: flex;
      flex-direction: column;
      padding-top: 96px;
    }

    .bed {
      flex: 1;
      display: flex;
      align-items: center;
    }

    .rail {
      flex: 1;
      min-width: 0;
    }

    .track {
      padding-left: 12%;
      will-change: transform;
    }

    /*
      Short screens: size the card to exactly the height left under the intro so it is never
      clipped. Mirrors the stage's top padding, the intro (heading or two-line lede, whichever
      is taller) and its bottom padding, and the bed's block padding.
    */
    .card {
      --room: calc(
        100svh - 96px
        - max(var(--step-heading), 2.6 * var(--step-lead))
        - clamp(32px, 5vh, 56px)
        - 2 * clamp(32px, 6vh, 64px)
      );
      width: min(600px, 44vw, var(--room) * 720 / 560);
    }
  }

  /* Phones and reduced motion: the press as a band, the cards stacked. */
  @media (max-width: 1023px), (prefers-reduced-motion: reduce) {
    .track {
      flex-wrap: wrap;
      gap: 24px;
    }

    .card {
      width: 100%;
      aspect-ratio: auto;
      grid-template-rows: auto 1fr;
    }

    .shot {
      aspect-ratio: 4 / 3;
    }

    .panel {
      grid-template-columns: minmax(0, 1fr);
      padding: 20px;
    }

    .meta {
      justify-self: start;
      text-align: left;
    }

    .meta a {
      justify-self: start;
    }

    .intro {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 16px;
    }
  }

  @media (min-width: 640px) and (max-width: 1023px), (min-width: 640px) and (prefers-reduced-motion: reduce) {
    .card {
      width: calc(50% - 12px);
    }
  }
</style>
