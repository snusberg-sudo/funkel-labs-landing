---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={['wordmark', className]}>
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M12 0C13 8 16 11 24 12C16 13 13 16 12 24C11 16 8 13 0 12C8 11 11 8 12 0Z" fill="currentColor"></path>
  </svg>
  <span>funkel labs</span>
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-wordmark);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    white-space: nowrap;
  }

  svg {
    width: 0.95em;
    height: 0.95em;
    flex: none;
  }
</style>
