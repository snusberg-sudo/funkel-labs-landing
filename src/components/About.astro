---
import type { Content } from '../i18n/content';

interface Props {
  t: Content;
}
const { t } = Astro.props;
---

<section id="about" class="about" aria-labelledby="about-title">
  <div class="wrap grid">
    <div class="story">
      <h2 id="about-title">{t.about.heading}</h2>
      <p class="phrased">{t.about.body}</p>
    </div>

    <div class="team">
      <h3 class="visually-hidden">{t.about.teamHeading}</h3>
      <ul>
        {t.about.people.map((person) => (
          <li>
            <div class:list={['photo', { slot: !person.photo }]}>
              {person.photo ? (
                <img src={person.photo} alt={person.name} loading="lazy" decoding="async" />
              ) : (
                <span class="grain" aria-hidden="true"><span>{t.about.photoPlaceholder}</span></span>
              )}
            </div>
            <p class="name">{person.name}</p>
            <p class="role">{person.role}</p>
            <p class="bio">{person.bio}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .about {
    padding-block: clamp(72px, 11vw, 144px);
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }

  h2 {
    font-size: clamp(2.25rem, 4.4vw, 3.75rem);
    line-height: 0.98;
  }

  .story p {
    margin-top: 28px;
    max-width: 30ch;
    font-size: clamp(1.375rem, 2.2vw, 1.875rem);
    line-height: 1.4;
  }

  :lang(ja) .story p {
    max-width: 22em;
    line-height: 1.7;
  }

  .team ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 40px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .photo {
    aspect-ratio: 1;
    border-radius: var(--radius-sheet);
    overflow: hidden;
    margin-bottom: 16px;
    background-color: var(--color-paper-2);
  }

  /* Portraits print in both drums: blue shadows into the light pink screen. */
  .photo:has(img) {
    position: relative;
    isolation: isolate;
  }

  .photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.15);
    mix-blend-mode: multiply;
  }

  .photo:has(img)::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--color-ink);
    mix-blend-mode: lighten;
  }

  .slot > span {
    display: grid;
    place-content: center;
    height: 100%;
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--color-muted);
  }

  .slot > span > span {
    position: relative;
    z-index: 2;
  }

  .name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.375rem;
    line-height: 1.1;
  }

  .role {
    color: var(--color-muted);
    font-size: 0.9375rem;
    margin-top: 2px;
  }

  .bio {
    margin-top: 8px;
    color: var(--color-ink-2);
    font-size: 1rem;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
