---
import { Image } from 'astro:assets';
import type { Content } from '../i18n/content';
import { picture } from '../scripts/pictures';
import Avatar from './Avatar.astro';

interface Props {
  t: Content;
}
const { t } = Astro.props;
const spark = 'M12 0C13 8 16 11 24 12C16 13 13 16 12 24C11 16 8 13 0 12C8 11 11 8 12 0Z';
// Team tiles rotate through screens of the two drums, so mixed portraits read as one set.
const tints = ['tint-stock', 'tint-blue', 'tint-pink', 'tint-ink'];

// A note is uncovered by a screen of pink cells: each cell lands at a random moment in the
// first beat and lifts at a random moment in the second, so the swap happens under full cover.
const cols = 8;
const rows = 10;
const beat = 280;
const screen = () =>
  Array.from({ length: cols * rows }, (_, k) =>
    `left:${(k % cols) * (100 / cols)}%;top:${Math.floor(k / cols) * (100 / rows)}%;` +
    `--land:${Math.round(Math.random() * beat)}ms;--lift:${Math.round(beat + Math.random() * beat)}ms`,
  );
---

<!-- Chapter five, the full pink drum: the name and the people behind it. -->
<section id="about" class="about grain" data-chapter aria-labelledby="about-title">
  <div class="wrap grid">
    <div class="story">
      <h2 id="about-title" data-rise>{t.about.heading}</h2>
      <p class="statement" data-rise style="--rise: 1">{t.about.statement}</p>
      <figure class="print" data-rise style="--rise: 2">
        <Image src={picture('/found/riso-two-colour.jpg')} alt="" widths={[640, 960, 1400]} sizes="(max-width: 760px) 100vw, 50vw" />
      </figure>
    </div>

    <div class="team">
      <h3 data-rise>{t.about.teamHeading}</h3>
      <ul>
        {t.about.people.map((person, i) => (
          <li data-rise style={`--rise: ${i + 1}`}>
            <div class:list={['tile', tints[i % tints.length], person.message && 'talk']}>
              {person.photo ? (
                <Image src={picture(person.photo)} alt={person.name} widths={[400, 800]} sizes="(max-width: 760px) 50vw, 25vw" />
              ) : person.avatar ? (
                <Avatar who={person.avatar} />
              ) : (
                // A drawn stand-in for anyone without a portrait or avatar.
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d={spark} transform="translate(4 4) scale(0.66)" class="mark" />
                </svg>
              )}
              {person.message && (
                <Fragment>
                  <blockquote class="note" lang={person.messageLang}>
                    <p>{person.message}</p>
                    {person.messageCite && <footer>{person.messageCite}</footer>}
                  </blockquote>
                  <span class="screen" aria-hidden="true">
                    {screen().map((style) => <span class="cell" style={style}><span /></span>)}
                  </span>
                  <button class="reveal" type="button" aria-pressed="false" aria-label={t.about.showMessage.replace('{name}', person.name)}>
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path class="quote" d="M4 18v-5c0-4 2-7 6-8l1 2c-2 1-3 2-3 4h3v7zm9 0v-5c0-4 2-7 6-8l1 2c-2 1-3 2-3 4h3v7z" />
                      <path class="close" d="M6 6l12 12M18 6L6 18" />
                    </svg>
                  </button>
                </Fragment>
              )}
            </div>
            <p class="name">{person.name}</p>
            <p class="role">{person.role}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  // Touch and keyboard: the corner button pins the note open or shut. Hover needs no script.
  for (const button of document.querySelectorAll<HTMLButtonElement>('.team .reveal')) {
    button.addEventListener('click', () => {
      button.setAttribute('aria-pressed', String(button.getAttribute('aria-pressed') !== 'true'));
    });
  }
</script>

<style>
  .about {
    background-color: var(--color-pink);
    color: var(--color-pink-ink);
    padding-block: var(--chapter-head) var(--section-gap);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: clamp(40px, 5vw, 80px);
    align-items: start;
  }

  h2 {
    font-size: var(--step-heading);
    line-height: 1;
  }

  .statement {
    margin-top: 28px;
    max-width: 34ch;
    font-size: var(--step-lead);
    line-height: 1.3;
  }

  :lang(ja) .statement {
    max-width: 23em;
    line-height: 1.6;
  }

  figure {
    margin: 40px 0 0;
  }

  /* Found pictures and portraits print in both drums: blue shadows into the light pink screen. */
  .print,
  .tile {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background-color: var(--color-paper-3);
  }

  .print {
    aspect-ratio: 3 / 2;
  }

  .print img,
  .tile img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.15);
    mix-blend-mode: multiply;
  }

  .print::after,
  .tile:has(img)::after {
    content: "";
    position: absolute;
    inset: 0;
    background-color: var(--color-ink);
    mix-blend-mode: lighten;
  }

  h3 {
    font-size: var(--step-lead);
    line-height: 1.1;
    margin-bottom: 24px;
  }

  .team {
    container-type: inline-size;
  }

  /* Two up only when each tile is wide enough to hold its founder's note. */
  .team ul {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 36px 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @container (min-width: 480px) {
    .team ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .tile {
    aspect-ratio: 4 / 5;
    margin-bottom: 10px;
  }

  .tile svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .tint-stock {
    background-color: var(--color-paper);
  }

  .tint-blue {
    background-color: var(--color-ink-5);
  }

  .tint-pink {
    background-color: var(--color-paper-2);
  }

  .tint-ink {
    background-color: var(--color-ink-4);
  }

  .mark {
    fill: var(--color-ink);
  }

  /* Founder notes: a screen of pink cells covers the portrait, then lifts off the printed note. */
  .note,
  .screen,
  .reveal {
    position: absolute;
    inset: 0;
  }

  .note {
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
    margin: 0;
    padding: clamp(16px, 2vw, 28px);
    padding-bottom: 56px;
    background-color: inherit;
    color: var(--color-ink);
    opacity: 0;
    transition: opacity 0s linear 280ms;
  }

  .note p {
    font-size: var(--step-body);
    line-height: 1.45;
    white-space: pre-line;
    text-wrap: pretty;
  }

  :lang(ja) .note p:not(:lang(en)) {
    line-height: 1.8;
    word-break: auto-phrase;
    line-break: strict;
  }

  .note footer {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-small);
  }

  .note footer::before {
    content: "— ";
  }

  .screen {
    z-index: 2;
    pointer-events: none;
  }

  /* Each cell shows only while both its layers are up: the outer lands, the inner lifts. */
  .cell {
    position: absolute;
    width: calc(100% / 8 + 1px);
    height: calc(100% / 10 + 1px);
    opacity: 0;
    transition: opacity 0s linear var(--lift);
  }

  .cell > span {
    display: block;
    width: 100%;
    height: 100%;
    background-color: var(--color-pink);
    transition: opacity 0s linear var(--land);
  }

  .reveal {
    z-index: 3;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-pink-ink);
    cursor: pointer;
  }

  .reveal:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: -4px;
  }

  .reveal svg {
    width: 44px;
    height: 44px;
    padding: 11px;
    background-color: var(--color-pink);
    background-image: var(--grain);
  }

  .quote {
    fill: currentColor;
  }

  .close {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    display: none;
  }

  .talk:has([aria-pressed="true"]) .quote {
    display: none;
  }

  .talk:has([aria-pressed="true"]) .close {
    display: inline;
  }

  .talk:has([aria-pressed="true"]) .note {
    opacity: 1;
  }

  .talk:has([aria-pressed="true"]) .cell {
    opacity: 1;
    transition-delay: var(--land);
  }

  .talk:has([aria-pressed="true"]) .cell > span {
    opacity: 0;
    transition-delay: var(--lift);
  }

  @media (hover: hover) {
    .talk:hover .note {
      opacity: 1;
    }

    .talk:hover .cell {
      opacity: 1;
      transition-delay: var(--land);
    }

    .talk:hover .cell > span {
      opacity: 0;
      transition-delay: var(--lift);
    }
  }

  /* Without movement the note simply fades in over the portrait. */
  @media (prefers-reduced-motion: reduce) {
    .screen {
      display: none;
    }

    .note {
      transition: opacity 200ms var(--ease-out);
    }
  }

  .name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-body);
    line-height: 1.2;
  }

  .role {
    font-size: var(--step-small);
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .team ul {
      gap: 28px 8px;
    }
  }
</style>
