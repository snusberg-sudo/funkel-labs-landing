---
import { Image } from 'astro:assets';
import { contactEmail, contactEmailParts, type Content } from '../i18n/content';
import { picture } from '../scripts/pictures';

interface Props {
  t: Content;
}
const { t } = Astro.props;
// TODO: create a Web3Forms access key for the studio inbox and set PUBLIC_WEB3FORMS_KEY.
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const f = t.contact.fields;
const p = t.contact.poster;
const spark = 'M12 0C13 8 16 11 24 12C16 13 13 16 12 24C11 16 8 13 0 12C8 11 11 8 12 0Z';
---

<!--
  The last chapter, the full blue drum. The one live thing on the page: the
  visitor types an idea and watches it come off the press as a two-ink poster,
  then sends that print as their enquiry. Without script the poster shows an
  example and the form posts as usual.
-->
<section id="contact" class="contact grain" data-chapter aria-labelledby="contact-title">
  <div class="wrap">
    <div class="intro">
      <h2 id="contact-title" data-rise>{t.contact.heading}</h2>
      <p class="phrased" data-rise style="--rise: 1">{t.contact.lede}</p>
    </div>

    <div class="press">
      <form
        class="form"
        action="https://api.web3forms.com/submit"
        method="POST"
        data-contact
        data-sending={t.contact.sending}
        data-sent={t.contact.sent}
        data-failed={t.contact.failed}
        data-rise
        style="--rise: 2"
      >
        <input type="hidden" name="access_key" value={accessKey} />
        <input type="hidden" name="subject" value={t.contact.subject} />
        <input type="hidden" name="from_name" value="Funkel Labs website" />
        <!-- Web3Forms spam trap: bots tick it, people never see it. -->
        <input type="checkbox" name="botcheck" class="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <label class="idea">
          <span>{f.message}</span>
          <textarea name="message" rows="3" maxlength="600" required placeholder={p.example} aria-describedby="message-hint" data-idea></textarea>
          <small id="message-hint">{f.messageHint}</small>
        </label>
        <div class="pair">
          <label>
            <span>{f.name}</span>
            <input type="text" name="name" autocomplete="name" required data-name />
          </label>
          <label>
            <span>{f.email}</span>
            <input type="email" name="email" autocomplete="email" required />
          </label>
        </div>
        <label>
          <span>{f.company}</span>
          <input type="text" name="company" autocomplete="organization" />
        </label>

        <div class="submit">
          <button class="btn btn-primary" type="submit">{t.contact.submit}</button>
          <p class="status" role="status" aria-live="polite" data-status></p>
        </div>
      </form>

      <figure class="poster-wrap" data-rise style="--rise: 3">
        <div class="poster grain" data-poster data-examples={JSON.stringify(p.examples)} aria-hidden="true">
          <svg class="poster-spark" viewBox="0 0 24 24" focusable="false">
            <path d={spark} class="spark-pink" />
            <path d={spark} class="spark-blue" transform="translate(0.6 0.5)" />
          </svg>
          <!-- The plates are drawn from data-text: the poster is a picture of the idea, which lives in the form field. -->
          <div class="plates" data-plates>
            <span class="plate plate-pink" data-plate-text data-text={p.example}></span>
            <span class="plate plate-blue" data-plate-text data-text={p.example}></span>
          </div>
          <p class="credit">
            {t.lang === 'ja' ? (
              <Fragment><span data-printed-for>{p.you}</span>{p.by}</Fragment>
            ) : (
              <Fragment>{p.printedFor}{' '}<span data-printed-for>{p.you}</span>{' '}{p.by}</Fragment>
            )}
          </p>
        </div>
      </figure>
    </div>

    <ul class="rows">
      <li class="row" data-rise>
        <a href={`mailto:${contactEmail}`}>{contactEmailParts.map((part, i) => <>{i > 0 && <wbr />}{part}</>)}</a>
        {/* A coin cut from a 2.2:1 picture: the file must be about 2.2 times the coin's width to fill its height. */}
        <Image class="round" src={picture('/found/ink-roller.jpg')} alt="" widths={[320, 640]} sizes="320px" />
      </li>
      <li class="row" data-rise style="--rise: 1">{t.contact.languages}</li>
      <li class="row hello" data-rise style="--rise: 2">
        <span>{t.contact.hello}</span>
        <a class="go" href={`mailto:${contactEmail}`} aria-label={t.contact.helloLabel}>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h13M12 5l7 7-7 7" /></svg>
        </a>
      </li>
    </ul>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact]');
  const status = form?.querySelector<HTMLElement>('[data-status]');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const idea = form?.querySelector<HTMLTextAreaElement>('[data-idea]');
  const nameInput = form?.querySelector<HTMLInputElement>('[data-name]');
  const poster = document.querySelector<HTMLElement>('[data-poster]');
  const plates = poster?.querySelector<HTMLElement>('[data-plates]');
  const texts = poster ? [...poster.querySelectorAll<HTMLElement>('[data-plate-text]')] : [];
  const printedFor = poster?.querySelector<HTMLElement>('[data-printed-for]');
  const motion = window.matchMedia('(prefers-reduced-motion: no-preference)');

  // Set the idea as large as the sheet allows, one step at a time.
  const fit = () => {
    if (!plates || !texts[0]) return;
    const box = plates.getBoundingClientRect();
    let size = Math.min(box.width * 0.24, 160);
    for (const el of texts) el.style.fontSize = `${size}px`;
    while (size > 18 && (texts[0].offsetHeight > box.height + 0.5 || texts[0].scrollWidth > box.width + 1)) {
      size *= 0.92;
      for (const el of texts) el.style.fontSize = `${size}px`;
    }
  };

  // Each new impression lands a little off, then the plates settle into register.
  const strike = () => {
    if (!plates || !motion.matches) return;
    const dx = 6 + Math.random() * 8;
    const dy = 4 + Math.random() * 6;
    plates.animate(
      [{ '--drift-x': `${dx}px`, '--drift-y': `${dy}px` }, { '--drift-x': '2.5px', '--drift-y': '2px' }],
      { duration: 520, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' },
    );
  };

  const fallbackIdea = texts[0]?.dataset.text ?? '';
  const fallbackName = printedFor?.textContent ?? '';
  const render = () => {
    const value = idea?.value.trim() || fallbackIdea;
    const shown = value.length > 140 ? `${value.slice(0, 137).trimEnd()}…` : value;
    for (const el of texts) el.dataset.text = shown;
    if (printedFor) printedFor.textContent = nameInput?.value.trim() || fallbackName;
    fit();
  };

  if (poster && idea) {
    idea.addEventListener('input', () => {
      render();
      strike();
    });
    nameInput?.addEventListener('input', render);
    new ResizeObserver(fit).observe(poster);
    document.fonts?.ready.then(fit);
    render();
  }

  // Until the visitor starts, the press sets a few sample ideas itself, one letter at a time, so the
  // poster shows what it does. The visitor's own words always win: any focus or typing stops it for good.
  const examples: string[] = JSON.parse(poster?.dataset.examples ?? '[]');
  if (poster && plates && idea && form && examples.length && motion.matches) {
    const placeholder = idea.placeholder;
    let timer = 0;
    let lift: Animation | undefined;
    let visible = false;
    let stopped = false;
    let running = false;
    let index = 0;

    const set = (text: string) => {
      for (const el of texts) el.dataset.text = text;
    };
    const wait = (ms: number, next: () => void) => {
      timer = window.setTimeout(next, ms);
    };

    const play = () => {
      if (stopped || !visible) { running = false; return; }
      running = true;
      const full = examples[index];
      // Fit the whole line first so the letters keep one size while they are set.
      set(full);
      fit();
      set('');
      idea.placeholder = full;
      let count = 0;
      const type = () => {
        if (stopped || !visible) { running = false; return; }
        count += 1;
        set(full.slice(0, count));
        strike();
        if (count < full.length) {
          // A typist's pace: uneven, a little quicker after a space.
          wait((full[count - 1] === ' ' ? 40 : 70) + Math.random() * 60, type);
          return;
        }
        // Printed: hold, then the sheet lifts off and the next idea is set.
        wait(2600, () => {
          if (stopped || !visible) { running = false; return; }
          lift = plates.animate(
            [{ opacity: 1, transform: 'translateY(0)' }, { opacity: 0, transform: 'translateY(-14px)' }],
            { duration: 420, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'forwards' },
          );
          lift.onfinish = () => {
            lift?.cancel();
            set('');
            index = (index + 1) % examples.length;
            wait(260, play);
          };
        });
      };
      wait(380, type);
    };

    const stop = () => {
      if (stopped) return;
      stopped = true;
      window.clearTimeout(timer);
      lift?.cancel();
      idea.placeholder = placeholder;
      render();
    };
    form.addEventListener('focusin', stop);
    form.addEventListener('input', stop);

    // Runs only while the poster is on screen; leaving mid-line restarts that idea on return.
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting && entry.intersectionRatio >= 0.6;
      if (!visible) {
        window.clearTimeout(timer);
        lift?.cancel();
        running = false;
        if (!stopped) {
          set(examples[index]);
          fit();
        }
      } else if (!running) {
        play();
      }
    }, { threshold: [0, 0.6, 1] }).observe(poster);
  }

  // Status prints itself as a stamped line on the sheet, never a toast.
  const print = (state: 'sending' | 'sent' | 'failed') => {
    if (!form || !status) return;
    // Clear and reflow first so the stamp lands again on a repeat result.
    delete status.dataset.state;
    void status.offsetWidth;
    status.dataset.state = state;
    status.textContent = form.dataset[state] ?? '';
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!button) return;
    button.disabled = true;
    print('sending');
    try {
      const response = await fetch(form.action, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new FormData(form),
      });
      const result = (await response.json().catch(() => ({}))) as { success?: boolean };
      if (!response.ok || !result.success) throw new Error('Submission failed');
      form.reset();
      render();
      print('sent');
    } catch {
      print('failed');
    } finally {
      button.disabled = false;
    }
  });
</script>

<style>
  @property --drift-x {
    syntax: "<length>";
    inherits: true;
    initial-value: 2.5px;
  }

  @property --drift-y {
    syntax: "<length>";
    inherits: true;
    initial-value: 2px;
  }

  .contact {
    background-color: var(--color-ink);
    color: var(--color-on-ink);
    padding-block: var(--chapter-head) 0;
  }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    column-gap: clamp(16px, 2.2vw, 32px);
    align-items: end;
    margin-bottom: clamp(40px, 6vw, 72px);
  }

  h2 {
    font-size: var(--step-heading);
    line-height: 1;
  }

  .intro p {
    font-size: var(--step-body);
    max-width: 44ch;
  }

  /* The same 7/5 split and gutter as the intro, so the poster stands under the lede at every height. */
  .press {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    column-gap: clamp(16px, 2.2vw, 32px);
    align-items: start;
  }

  .botcheck {
    display: none;
  }

  .form {
    display: grid;
    gap: 22px;
  }

  .pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  label {
    display: grid;
    gap: 8px;
  }

  label > span {
    font-size: var(--step-small);
    font-weight: 600;
  }

  input,
  textarea {
    width: 100%;
    min-height: 52px;
    padding: 14px 16px;
    font: inherit;
    font-size: var(--step-body);
    color: var(--color-pink-ink);
    background-color: var(--color-paper);
    border: 0;
    border-radius: var(--radius-sheet);
    transition: background-color 160ms var(--ease-out);
  }

  textarea {
    resize: vertical;
    min-height: 120px;
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--color-muted);
  }

  input:hover,
  textarea:hover {
    background-color: var(--color-paper-2);
  }

  input:focus-visible,
  textarea:focus-visible {
    outline: 3px solid var(--color-pink);
    outline-offset: 2px;
    background-color: var(--color-paper);
  }

  /* The global focus blue disappears on the blue field; every control here takes the pink ring. */
  .contact :is(a, button):focus-visible {
    outline: 3px solid var(--color-pink);
    outline-offset: 3px;
  }

  input:user-invalid,
  textarea:user-invalid {
    background-color: var(--color-paper-3);
  }

  small {
    font-size: var(--step-small);
    color: var(--color-on-ink-muted);
  }

  .submit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
  }

  .status {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-body);
    line-height: 1.3;
  }

  :lang(ja) .status {
    font-family: var(--font-body);
    font-weight: 700;
  }

  .status:empty {
    display: none;
  }

  .status[data-state="sending"] {
    color: var(--color-on-ink-muted);
  }

  .status[data-state="sent"] {
    padding: 4px 10px;
    background-color: var(--color-pink);
    color: var(--color-pink-ink);
    border-radius: var(--radius-sheet);
  }

  .status[data-state="failed"] {
    padding: 4px 10px;
    background-color: var(--color-paper-2);
    color: var(--color-pink-ink);
    border-radius: var(--radius-sheet);
  }

  /* A result lands like a rubber stamp: pressed down, a hair askew, then square. */
  .status[data-state="sent"],
  .status[data-state="failed"] {
    animation: stamp-ink 180ms var(--ease-out);
  }

  @media (prefers-reduced-motion: no-preference) {
    .status[data-state="sent"],
    .status[data-state="failed"] {
      animation: stamp 260ms var(--ease-out);
    }
  }

  @keyframes stamp {
    from {
      opacity: 0;
      transform: scale(1.12) rotate(-2deg);
    }
    60% {
      opacity: 1;
      transform: scale(0.98) rotate(0.4deg);
    }
  }

  @keyframes stamp-ink {
    from {
      opacity: 0;
    }
  }

  button[disabled] {
    cursor: progress;
  }

  /* The poster: a sheet of stock with the idea in both drums, purple where they cross. */
  .poster-wrap {
    margin: 0;
  }

  .poster {
    position: relative;
    aspect-ratio: 3 / 4;
    max-height: min(78svh, var(--chapter-room));
    background-color: var(--color-paper);
    color: var(--color-ink);
    padding: clamp(20px, 3vw, 36px);
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    isolation: isolate;
    overflow: hidden;
  }

  .poster-spark {
    width: 22%;
    justify-self: end;
  }

  .spark-pink {
    fill: var(--color-pink);
  }

  .spark-blue {
    fill: var(--color-ink);
    mix-blend-mode: multiply;
  }

  .plates {
    position: relative;
    min-height: 0;
    align-self: stretch;
    margin-block: 12px;
  }

  /* Each plate sits on the foot of the sheet at its own height, so the fit can measure it. */
  .plate {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: block;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: var(--tracking-display);
    overflow-wrap: break-word;
    hyphens: auto;
  }

  .plate::before {
    content: attr(data-text);
  }

  .plate-pink {
    color: var(--color-pink);
    transform: translate(var(--drift-x), var(--drift-y));
  }

  .plate-blue {
    color: var(--color-ink);
    mix-blend-mode: multiply;
  }

  .credit {
    font-size: var(--step-small);
    color: var(--color-ink);
  }

  .credit span {
    font-weight: 700;
  }

  /* The details in display rows, on two alternating screens of the blue drum. */
  .rows {
    margin: clamp(72px, 10vw, 140px) calc(-1 * var(--gutter)) 0;
    padding: 0;
    list-style: none;
  }

  .row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    min-height: clamp(96px, 10vw, 150px);
    padding: 0 var(--gutter) 20px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-heading);
    line-height: 1;
    letter-spacing: var(--tracking-display);
    overflow-wrap: anywhere;
  }

  .row:nth-child(odd) {
    background-color: var(--color-ink-3);
  }

  .row a {
    text-decoration-thickness: 3px;
  }

  .round {
    flex: none;
    width: 1.4em;
    height: 1.4em;
    margin-bottom: -0.2em;
    border-radius: 50%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.2);
    mix-blend-mode: luminosity;
  }

  .go {
    display: grid;
    place-items: center;
    flex: none;
    width: 0.9em;
    height: 0.9em;
    border-radius: 50%;
    background-color: var(--color-pink);
    color: var(--color-pink-ink);
    transition: transform 160ms var(--ease-out), background-color 160ms var(--ease-out);
  }

  .go:hover {
    background-color: var(--color-paper-3);
    transform: translateX(4px);
  }

  .go:active {
    transform: translate(5px, 1px);
  }

  .go svg {
    width: 44%;
    fill: none;
    stroke: currentColor;
    stroke-width: 3;
  }

  @media (max-width: 760px) {
    .intro,
    .press {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 20px;
    }

    .poster {
      max-height: none;
    }

    .pair {
      grid-template-columns: minmax(0, 1fr);
    }

    .row {
      min-height: 84px;
      padding-bottom: 14px;
    }

    .hello {
      background-color: var(--color-pink);
      color: var(--color-pink-ink);
    }

    .hello .go {
      width: 56px;
      height: 56px;
      background-color: var(--color-pink-ink);
      color: var(--color-paper);
    }
  }
</style>
