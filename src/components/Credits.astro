---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Wordmark from './Wordmark.astro';
import Footer from './Footer.astro';
import credits from '../../public/found/credits.json';
import { content, type Lang } from '../i18n/content';
import { picture } from '../scripts/pictures';

interface Props {
  lang: Lang;
}
const t = content[Astro.props.lang];
const home = t.lang === 'ja' ? '/ja/' : '/';
// A picture is shown from src/assets; a film (served from public) by its poster frame.
const still = (file: string) => picture(file.replace(/^src\/assets/, ''));
const poster = (file: string) => file.replace(/^public/, '').replace(/\.webm$/, '-poster.jpg');
---

<Base lang={t.lang} title={`${t.credits.title} | Funkel Labs`} description={t.credits.lede} path="/credits/">
  <header class="wrap top">
    <a href={home} aria-label={t.nav.home}><Wordmark /></a>
  </header>
  <main class="wrap doc">
    <h1>{t.credits.title}</h1>
    <p>{t.credits.lede}</p>
    <ul class="list">
      {credits.map((c) => (
        <li>
          <span class="thumb">
            {c.media === 'image'
              ? <Image src={still(c.file)} alt="" widths={[120, 240]} sizes="120px" />
              : <img src={poster(c.file)} alt="" width="160" height="120" loading="lazy" decoding="async" />}
          </span>
          <p>
            {t.lang === 'ja' ? (
              <Fragment><a href={c.page}>「{c.title}」</a>、{c.creator}、<a href={c.licenseUrl}>{c.license}</a>（{c.via}）</Fragment>
            ) : (
              <Fragment><a href={c.page}>“{c.title}”</a> by {c.creator}, <a href={c.licenseUrl}>{c.license}</a>, via {c.via}</Fragment>
            )}
          </p>
        </li>
      ))}
    </ul>
    <p><a href={home}>{t.credits.back}</a></p>
  </main>
  <Footer t={t} />
</Base>

<style>
  .top {
    padding-block: 28px;
    font-size: 1.5rem;
  }

  .top a {
    text-decoration: none;
  }

  .doc {
    max-width: calc(68ch + 2 * var(--gutter));
    padding-block: clamp(40px, 6vw, 80px);
    display: grid;
    gap: 28px;
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 0.95;
  }

  .list {
    display: grid;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .list li {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 20px;
    align-items: center;
  }

  /* Printed in the site's two-drum duotone, like every found picture: shadows blue, lights pink. */
  .thumb {
    position: relative;
    width: 120px;
    height: 90px;
    border-radius: 2px;
    overflow: hidden;
    background-color: var(--color-paper-3);
    isolation: isolate;
  }

  .thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.15);
    mix-blend-mode: multiply;
  }

  .thumb::after {
    content: "";
    position: absolute;
    inset: 0;
    background-color: var(--color-ink);
    mix-blend-mode: lighten;
  }

  .list p {
    overflow-wrap: anywhere;
  }

  /* Links inside running text carry the house underline (pink, 2px), not colour alone. */
  .doc p a {
    text-decoration-line: underline;
  }
</style>
