---
import type { Content } from '../i18n/content';

interface Props {
  t: Content;
}
const { t } = Astro.props;
---

<!-- Chapter two, the pink screen: what we build, at poster scale. The heading is the list's first line. -->
<section id="services" class="services grain" data-chapter aria-labelledby="services-title">
  <div class="wrap">
    <h2 id="services-title" class="row-name heading" data-rise>{t.services.heading}</h2>
    <ul class="list">
      {t.services.items.map((item, i) => (
        <li class="row" data-rise style={`--rise: ${i + 1}`}>
          <h3 class="row-name">{item.name}</h3>
          <p>{item.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .services {
    background-color: var(--color-paper-3);
    color: var(--color-pink-ink);
    min-height: 90svh;
    padding-block: clamp(96px, 20vh, 200px);
  }

  .row-name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-heading);
    line-height: 1;
    letter-spacing: var(--tracking-display);
    margin: 0;
  }

  .heading {
    color: var(--color-ink);
    margin-bottom: 0.35em;
  }

  .list {
    display: grid;
    gap: 0.35em;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--step-heading);
  }

  /* Each name across eight columns, its sentence in the last four on the same baseline. */
  .row {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    column-gap: clamp(16px, 2.2vw, 32px);
    align-items: first baseline;
  }

  .row p {
    font-size: var(--step-body);
    line-height: 1.5;
    max-width: 40ch;
  }

  @media (max-width: 760px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 10px;
      margin-bottom: 28px;
    }

    .row p {
      padding-left: var(--gutter);
    }
  }
</style>
