---
import type { Content } from '../i18n/content';

interface Props {
  t: Content;
}
const { t } = Astro.props;
---

<!-- Chapter two, the pink screen: what we build, at poster scale. The heading is the list's first line. -->
<section id="services" class="services grain" data-chapter data-services aria-labelledby="services-title">
  <div class="wrap">
    <h2 id="services-title" class="row-name heading" data-rise data-services-heading>
      <span class="plate" data-text={t.services.heading}>{t.services.heading}</span>
    </h2>
    <ul class="list">
      {t.services.items.map((item, i) => (
        <li class="row" data-rise data-service style={`--rise: ${i + 1}`}>
          <h3 class="row-name">
            <span class="plate" data-text={item.name}>{item.name}</span>
          </h3>
          <p>{item.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  // The press run: a pink plate rolls across the line in hand; once it is printed, the next line takes the press.
  const section = document.querySelector<HTMLElement>('[data-services]');
  const heading = section?.querySelector<HTMLElement>('[data-services-heading]');
  const rows = section ? [...section.querySelectorAll<HTMLElement>('[data-service]')] : [];
  const cycle = window.matchMedia('(min-width: 761px) and (prefers-reduced-motion: no-preference)');

  if (section && heading && rows.length) {
    let active = -1; // the heading holds the first beat only
    let hovering = false;
    let focused = false;
    let visible = false;
    let locked = false;

    // Each name becomes a real button only once the press can run.
    const buttons = rows.map((row, index) => {
      const plate = row.querySelector<HTMLElement>('.plate')!;
      const button = document.createElement('button');
      // Carry every attribute across, the style scope included, so the plate's rules still apply.
      for (const { name, value } of plate.attributes) button.setAttribute(name, value);
      button.type = 'button';
      button.textContent = plate.textContent;
      button.setAttribute('aria-pressed', 'false');
      button.addEventListener('click', () => {
        locked = true;
        show(index);
      });
      button.addEventListener('focus', () => show(index));
      plate.replaceWith(button);
      return button;
    });

    const sync = () => {
      section.classList.toggle('is-paused', hovering || focused || !visible || document.hidden);
      section.classList.toggle('is-locked', locked);
    };

    const show = (index: number) => {
      active = index;
      (index < 0 ? heading : rows[index]).classList.remove('is-printed');
      heading.classList.toggle('is-active', index < 0);
      rows.forEach((row, i) => {
        row.classList.toggle('is-active', i === index);
        buttons[i].setAttribute('aria-pressed', String(i === index));
      });
      sync();
    };

    // The plate's roll is the timer: when it finishes, the line is printed and the next one comes up.
    section.addEventListener('animationend', (event) => {
      const line = (event.target as Element).closest('.is-active');
      if (event.pseudoElement !== '::before' || !line || locked) return;
      // The printed sheet keeps its full plate while it lifts away.
      line.classList.add('is-printed');
      show((active + 1) % rows.length);
    });

    const list = section.querySelector<HTMLElement>('.list')!;
    // Only a mouse that really moves counts: a cursor left resting where a jump lands must not stop the run.
    list.addEventListener('pointermove', (event) => {
      if (event.pointerType !== 'mouse' || (!event.movementX && !event.movementY)) return;
      hovering = true;
      const index = buttons.indexOf((event.target as Element).closest('button') as HTMLButtonElement);
      if (index >= 0 && index !== active && !locked) show(index);
      else sync();
    });
    list.addEventListener('pointerleave', () => { hovering = false; sync(); });
    list.addEventListener('focusin', () => { focused = true; sync(); });
    list.addEventListener('focusout', (event) => {
      if (!list.contains(event.relatedTarget as Node)) { focused = false; sync(); }
    });
    document.addEventListener('visibilitychange', sync);

    // Runs only while the chapter holds the screen; leaving it hands the press back to the run.
    new IntersectionObserver(([entry]) => {
      visible = entry.intersectionRect.height >= window.innerHeight * 0.5;
      if (!entry.isIntersecting && locked) {
        locked = false;
        show(-1);
      }
      sync();
    }, { threshold: [0, 0.25, 0.5, 0.75, 1] }).observe(section);

    const arm = () => {
      section.classList.toggle('is-cycling', cycle.matches);
      sync();
    };
    cycle.addEventListener('change', arm);
    show(-1);
    arm();
  }
</script>

<style>
  .services {
    --dwell: 4.5s;
    background-color: var(--color-paper-3);
    color: var(--color-pink-ink);
    min-height: 100svh;
    padding-block: var(--chapter-head) clamp(96px, 20vh, 200px);
  }

  .row-name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-heading);
    line-height: 1;
    letter-spacing: var(--tracking-display);
    margin: 0;
  }

  .heading {
    color: var(--color-ink);
    margin-bottom: 0.35em;
  }

  .list {
    display: grid;
    gap: 0.35em;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--step-heading);
  }

  /* Each name across eight columns, its sentence in the last four on the same baseline. */
  .row {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    column-gap: clamp(16px, 2.2vw, 32px);
    align-items: first baseline;
  }

  .row p {
    font-size: var(--step-body);
    line-height: 1.5;
    max-width: 40ch;
  }

  .plate {
    position: relative;
    display: inline-block;
  }

  /* The names become buttons that still read as type. */
  button.plate {
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-align: left;
    cursor: pointer;
  }

  /* The press run (desktop, motion allowed). Without it every line and sentence simply stays printed. */
  .services:global(.is-cycling) .row .row-name {
    color: var(--color-pink-ink);
    transition: color 260ms var(--ease-out);
  }

  .services:global(.is-cycling) .row:global(.is-active) .row-name {
    color: var(--color-ink);
  }

  /* The sentences share one panel across the last five columns, set at statement size opposite the list.
     The sentence of the line in hand strikes a little off register and settles; the others wait unseen. */
  .services:global(.is-cycling) .list {
    position: relative;
  }

  .services:global(.is-cycling) .row p {
    position: absolute;
    inset-block: 0;
    right: 0;
    width: calc((100% - var(--gutter)) * 5 / 12);
    max-width: none;
    display: flex;
    align-items: center;
    margin: 0;
    font-size: var(--step-lead);
    line-height: 1.3;
    opacity: 0;
    transform: translate(0.4em, 0.25em);
    pointer-events: none;
    transition: opacity 200ms var(--ease-out), transform 0s linear 200ms;
  }

  .services:global(.is-cycling) .row:global(.is-active) p {
    opacity: 1;
    transform: none;
    pointer-events: auto;
    transition: opacity 420ms var(--ease-out), transform 520ms var(--ease-out);
  }

  /* The pink plate: the line's own letters, rolled on from the left over the dwell, purple where it overprints the blue. */
  .services:global(.is-cycling) .plate::before {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    color: var(--color-pink);
    mix-blend-mode: multiply;
    /* At rest off the line, the plate sits well out of register; it lifts back there as a printed line leaves. */
    transform: translate(0.16em, 0.12em);
    clip-path: inset(-0.25em 100% -0.25em -0.1em);
    opacity: 0;
    pointer-events: none;
    transition: opacity 420ms var(--ease-out), transform 420ms var(--ease-out);
  }

  .services:global(.is-cycling) :global(.is-active) .plate::before {
    opacity: 1;
    transform: translate(0.035em, 0.03em);
    transition: opacity 240ms var(--ease-out);
    animation: roll var(--dwell) linear forwards;
  }

  .services:global(.is-cycling) :global(.is-printed) .plate::before {
    clip-path: inset(-0.25em -0.1em -0.25em -0.1em);
  }

  .services:global(.is-cycling) .heading:global(.is-active) .plate::before {
    animation-duration: 3s;
  }

  .services:global(.is-paused) :global(.is-active) .plate::before {
    animation-play-state: paused;
  }

  /* A line picked by hand stays fully printed until the reader leaves the chapter. */
  .services:global(.is-locked) :global(.is-active) .plate::before {
    animation: none;
    clip-path: inset(-0.25em -0.1em -0.25em -0.1em);
  }

  @keyframes roll {
    to {
      clip-path: inset(-0.25em -0.1em -0.25em -0.1em);
    }
  }

  @media (max-width: 760px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 10px;
      margin-bottom: 28px;
    }

    .row p {
      padding-left: var(--gutter);
    }
  }
</style>
