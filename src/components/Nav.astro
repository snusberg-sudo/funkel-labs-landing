---
import Wordmark from './Wordmark.astro';
import type { Content } from '../i18n/content';

interface Props {
  t: Content;
}
const { t } = Astro.props;
const home = t.lang === 'ja' ? '/ja/' : '/';
---

<!-- A plain bar: the wordmark, the other language, one action. Section links live in the footer. -->
<header class="nav" data-nav>
  <div class="wrap nav-row">
    <a class="home" href={home} aria-label={t.nav.home}><Wordmark /></a>
    <div class="actions">
      <a class="lang" href={t.nav.switchHref} hreflang={t.nav.switchLang} lang={t.nav.switchLang}>{t.nav.switchLabel}</a>
      <a class="btn btn-primary cta" href="#contact">{t.nav.cta}</a>
    </div>
  </div>
</header>

<script>
  import { navHoldY } from '../scripts/nav-hold';

  // The bar steps aside while the reader scrolls down past the hero and returns on the way back up.
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  // How far a reader must scroll back up before the bar returns, so a stray nudge does not call it back.
  const reveal = 10;
  if (nav) {
    let last = window.scrollY;
    let turn = last; // where the current run up began
    let queued = false;
    const update = () => {
      queued = false;
      const y = window.scrollY;
      // A jump settles in sub-pixel steps at fractional zoom; holding still is not a turn back up.
      if (Math.abs(y - last) < 2) return;
      const hold = navHoldY();
      if (y > last) {
        turn = y;
        nav.classList.toggle('is-away', y > hold && !nav.contains(document.activeElement));
      } else if (turn - y >= reveal || y <= hold) {
        nav.classList.remove('is-away');
      }
      last = y;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!queued) {
          queued = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    nav.addEventListener('focusin', () => nav.classList.remove('is-away'));
  }
</script>

<style>
  .nav {
    view-transition-name: site-nav;
    position: sticky;
    top: 0;
    z-index: 20;
    background-color: var(--color-paper);
    transition: transform 320ms var(--ease-out);
  }

  .nav:global(.is-away) {
    transform: translateY(-100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav {
      transition: none;
    }
  }

  .nav-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 72px;
  }

  .home {
    font-size: var(--step-lead);
    text-decoration: none;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .lang {
    font-size: var(--step-body);
    font-weight: 500;
    text-decoration: none;
    padding-block: 10px;
  }

  .lang:hover {
    text-decoration: underline;
  }

  .cta {
    min-height: 44px;
    padding: 12px 20px;
  }

  @media (max-width: 480px) {
    .nav-row {
      min-height: 60px;
    }

    .actions {
      gap: 14px;
    }

    .cta {
      padding: 10px 14px;
      font-size: var(--step-small);
    }
  }
</style>
