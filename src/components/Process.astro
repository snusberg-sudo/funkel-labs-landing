---
import type { Content } from '../i18n/content';

interface Props {
  t: Content;
}
const { t } = Astro.props;
// Order is carried by ink: the first pass is the full blue drum, each later one a lighter screen of it.
const tones = ['tone-1', 'tone-2', 'tone-3', 'tone-4'];
---

<!--
  Chapter four, back on the stock: the four passes of the run as one accordion,
  darkest to lightest. Every stage is a real button; with no script all four
  stay readable as a stack.
-->
<section id="process" class="process" data-chapter aria-labelledby="process-title">
  <div class="wrap">
    <div class="intro">
      <h2 id="process-title" data-rise>{t.process.heading}</h2>
      <p class="phrased" data-rise style="--rise: 1">{t.process.lede}</p>
    </div>

    <ol class="stages" data-stages data-rise style="--rise: 2">
      {t.process.steps.map((step, i) => (
        <li class:list={['stage', tones[i]]} data-open={i === 0 ? 'true' : 'false'}>
          <img class="strip" src={step.photo} alt="" loading="lazy" decoding="async" width="1200" height="900" />
          <h3>
            <button type="button" class="tab" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`stage-${i}`}>
              <span>{step.name}</span>
            </button>
          </h3>
          <div class="body" id={`stage-${i}`}>
            <p>{step.body}</p>
            <figure>
              <img src={step.photo} alt={step.photoAlt} loading="lazy" decoding="async" width="1200" height="900" />
            </figure>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  const list = document.querySelector<HTMLElement>('[data-stages]');
  if (list) {
    list.classList.add('is-accordion');
    const stages = [...list.querySelectorAll<HTMLElement>('.stage')];
    const hoverable = window.matchMedia('(min-width: 761px) and (hover: hover)');
    const open = (target: HTMLElement) => {
      for (const stage of stages) {
        const isOpen = stage === target;
        stage.dataset.open = String(isOpen);
        stage.querySelector('.tab')?.setAttribute('aria-expanded', String(isOpen));
      }
    };
    for (const stage of stages) {
      stage.querySelector('.tab')?.addEventListener('click', () => open(stage));
      stage.addEventListener('pointerenter', () => {
        if (hoverable.matches) open(stage);
      });
    }
  }
</script>

<style>
  .process {
    background-color: var(--color-paper);
    padding-block: var(--chapter-head) var(--section-gap);
  }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 1fr) minmax(0, 5fr) minmax(0, 1fr);
    align-items: end;
    margin-bottom: 64px;
  }

  h2 {
    font-size: var(--step-heading);
    line-height: 1;
    grid-column: 1;
  }

  .intro p {
    grid-column: 3;
    font-size: var(--step-body);
    max-width: 48ch;
  }

  .stages {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stage {
    background-color: var(--stage-bg);
    color: var(--stage-ink);
  }

  .tone-1 {
    --stage-bg: var(--color-ink);
    --stage-ink: var(--color-on-ink);
  }

  .tone-2 {
    --stage-bg: var(--color-ink-3);
    --stage-ink: var(--color-on-ink);
  }

  .tone-3 {
    --stage-bg: var(--color-ink-4);
    --stage-ink: var(--color-pink-ink);
  }

  .tone-4 {
    --stage-bg: var(--color-ink-5);
    --stage-ink: var(--color-pink-ink);
  }

  h3 {
    margin: 0;
    font-size: inherit;
  }

  /* A closed pass shows a narrow strip of its picture, printed into its own ink. */
  .strip {
    display: none;
  }

  .tab {
    all: unset;
    box-sizing: border-box;
    display: flex;
    width: 100%;
    padding: 20px 24px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-lead);
    line-height: 1.1;
    letter-spacing: var(--tracking-display);
    color: inherit;
    cursor: pointer;
  }

  .tab:focus-visible {
    outline: 2px solid var(--color-pink);
    outline-offset: -4px;
  }

  .body {
    display: grid;
    gap: 20px;
    padding: 0 24px 24px;
  }

  .body p {
    max-width: 36ch;
    font-size: var(--step-body);
  }

  figure {
    margin: 0;
    overflow: hidden;
    background-color: var(--color-paper-3);
    isolation: isolate;
    position: relative;
  }

  /* Found pictures print in both drums: blue shadows into the light pink screen. */
  figure img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.15);
    mix-blend-mode: multiply;
  }

  figure::after {
    content: "";
    position: absolute;
    inset: 0;
    background-color: var(--color-ink);
    mix-blend-mode: lighten;
  }

  /* With the script: a horizontal accordion, the open pass at 58% and slivers for the rest. */
  @media (min-width: 761px) {
    .is-accordion {
      display: flex;
      height: min(520px, var(--chapter-room));
    }

    .is-accordion .stage {
      position: relative;
      flex: 1 1 0;
      min-width: 0;
      overflow: hidden;
      transition: flex-grow 450ms var(--ease-out);
    }

    .is-accordion .stage[data-open="true"] {
      flex-grow: 4.2;
    }

    .is-accordion .strip {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: grayscale(1) contrast(1.2);
      mix-blend-mode: multiply;
      opacity: 0.5;
      transition: opacity 300ms var(--ease-out);
    }

    .is-accordion .stage[data-open="true"] .strip {
      opacity: 0;
    }

    .is-accordion .tab {
      position: absolute;
      inset: 0;
      z-index: 1;
      align-items: flex-end;
      padding: 24px;
    }

    .is-accordion .tab span {
      transform-origin: left bottom;
      transform: translateX(1.1em) rotate(-90deg);
      white-space: nowrap;
    }

    .is-accordion .stage[data-open="true"] .tab {
      position: relative;
      align-items: flex-start;
      font-size: var(--step-heading);
      pointer-events: none;
    }

    .is-accordion .stage[data-open="true"] .tab span {
      transform: none;
    }

    .is-accordion .body {
      position: absolute;
      inset: auto 0 0;
      z-index: 1;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: end;
      padding: 24px;
      opacity: 0;
      visibility: hidden;
      transition: opacity 300ms var(--ease-out), visibility 0s linear 300ms;
    }

    .is-accordion .stage[data-open="true"] .body {
      opacity: 1;
      visibility: visible;
      transition: opacity 400ms var(--ease-out) 200ms, visibility 0s;
    }

    .is-accordion figure {
      aspect-ratio: 4 / 3;
    }

    .stage:not([data-open="true"]) .tab:hover {
      background-color: color-mix(in oklch, var(--stage-bg) 86%, var(--color-paper));
    }
  }

  @media (max-width: 760px) {
    .intro {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 16px;
    }

    .intro p {
      grid-column: 1;
    }

    .is-accordion .stage:not([data-open="true"]) .body {
      display: none;
    }

    figure {
      aspect-ratio: 4 / 3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .is-accordion .stage,
    .is-accordion .body {
      transition: none;
    }
  }
</style>
