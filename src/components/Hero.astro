---
import type { Content } from '../i18n/content';

interface Props {
  t: Content;
}
const { t } = Astro.props;
const lines = [t.hero.line1, t.hero.line2];
---

<!--
  The print run. Two fields meet at a seam: bright stock above, the blue drum
  below. The headline is set twice in the same place, blue ink on the stock and
  pink on the blue, each clipped to its own field, so the seam cuts through the
  second line. Scrolling feeds the sheet into the drum: the blue rises over the
  headline while the spark's two plates pull into register.
-->
<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="stage">
    <!-- The stock's copy is drawn from data-text, so the page carries the headline once, as the h1. -->
    <div class="sheet sheet-stock" aria-hidden="true">
      <p class="head">
        {lines.map((line, i) => (
          <span class="line"><span class="drawn" data-text={line} style={`--i: ${i}`}></span></span>
        ))}
      </p>
    </div>

    <!-- The drum's copy is the real heading: it is the one on top, and the whole of it shows once the sheet has fed. -->
    <div class="sheet sheet-drum grain">
      <h1 id="hero-title" class="head head-copy">
        {lines.map((line, i) => (
          <span class="line"><span style={`--i: ${i}`}>{line}</span></span>
        ))}
      </h1>
    </div>

    <p class="lede phrased">{t.hero.lede}</p>

    <figure class="spark" data-spark>
      <!-- Static print of the spark: what reduced-motion, no-WebGL and no-JS visitors see. -->
      <svg class="spark-static" viewBox="0 0 400 400" role="img" aria-label={t.hero.sparkAlt}>
        <defs>
          <pattern id="dots-pink" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(15)">
            <circle cx="3.5" cy="3.5" r="2.7" fill="var(--color-pink)"></circle>
          </pattern>
          <pattern id="dots-blue" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(75)">
            <circle cx="3" cy="3" r="1.7" fill="var(--color-ink)"></circle>
          </pattern>
        </defs>
        <g class="plate">
          <path d="M200 16C214 150 250 186 384 200C250 214 214 250 200 384C186 250 150 214 16 200C150 186 186 150 200 16Z" fill="var(--color-pink)" opacity="0.9"></path>
          <path d="M200 16C214 150 250 186 384 200L200 200Z M200 384C186 250 150 214 16 200L200 200Z" fill="url(#dots-pink)"></path>
        </g>
        <g class="plate" transform="translate(6 5)">
          <path d="M200 200L384 200C250 214 214 250 200 384Z M200 200L16 200C150 186 186 150 200 16Z" fill="url(#dots-blue)"></path>
        </g>
      </svg>
    </figure>
  </div>
</section>

<script>
  import { mountSpark } from '../scripts/spark';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const host = document.querySelector<HTMLElement>('[data-spark]');
  if (host) mountSpark(host);

  // Scroll feeds the sheet: progress 0 at the top of the hero, 1 when the pin releases.
  const pinned = window.matchMedia('(min-width: 761px) and (prefers-reduced-motion: no-preference)');
  if (hero && host) {
    let queued = false;
    const update = () => {
      queued = false;
      let progress = 0;
      if (pinned.matches) {
        const rect = hero.getBoundingClientRect();
        const stage = hero.firstElementChild as HTMLElement;
        const travel = rect.height - stage.offsetHeight;
        // The stage pins below the nav, so the run starts and ends at its sticky offset.
        const pin = parseFloat(getComputedStyle(stage).top) || 0;
        progress = travel > 0 ? Math.min(1, Math.max(0, (pin - rect.top) / travel)) : 0;
      }
      hero.style.setProperty('--progress', progress.toFixed(4));
      host.dispatchEvent(new CustomEvent('printrun', { detail: progress }));
    };
    const queue = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('jumpframe', update);
    window.addEventListener('resize', queue);
    pinned.addEventListener('change', queue);
    update();
  }
</script>

<style>
  .hero {
    --progress: 0;
    --seam-start: 56%;
    /* The seam rises from just past halfway to the top as the sheet feeds. */
    --seam: calc(var(--seam-start) * (1 - var(--progress)));
    /* The content edge of .wrap, so the headline and spark line up with the nav above them on wide screens. */
    --edge: max(var(--gutter), (100% - var(--measure)) / 2);
    position: relative;
  }

  .stage {
    position: relative;
    height: calc(100svh - 72px);
    min-height: 560px;
    overflow: hidden;
  }

  .sheet {
    position: absolute;
    inset: 0;
  }

  /* Each sheet keeps only its own side of the seam, so neither copy of the headline lies under the other. */
  .sheet-stock {
    background-color: var(--color-paper);
    clip-path: inset(0 0 calc(100% - var(--seam)) 0);
  }

  .sheet-drum {
    background-color: var(--color-ink);
    clip-path: inset(var(--seam) 0 0 0);
  }

  .head {
    position: absolute;
    left: var(--edge);
    /* Put the middle of the second line on the seam. */
    top: calc(var(--seam-start) - 1.29em);
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-display);
    line-height: 0.86;
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    color: var(--color-ink);
  }

  :lang(ja) .head {
    text-transform: none;
    line-height: 1.02;
    top: calc(var(--seam-start) - 1.53em);
  }

  .head-copy {
    color: var(--color-pink);
  }

  .line {
    display: block;
    overflow: clip;
    padding-bottom: 0.02em;
  }

  .line > span {
    display: block;
  }

  .drawn::before {
    content: attr(data-text);
  }

  /* The supporting sentence sits 40px under the headline's last line, on the drum. */
  .lede {
    --head-size: var(--step-display);
    --head-foot: 0.43;
    position: absolute;
    left: var(--edge);
    top: calc(var(--seam-start) + var(--head-size) * var(--head-foot) + 40px);
    max-width: 34ch;
    font-size: var(--step-lead);
    line-height: 1.3;
    color: var(--color-on-ink);
  }

  :lang(ja) .lede {
    --head-foot: 0.51;
    max-width: 26em;
  }

  .spark {
    position: absolute;
    top: 6%;
    right: var(--edge);
    width: min(34vw, 44svh);
    aspect-ratio: 1;
    margin: 0;
    z-index: 2;
    /* The canvas prints white stock; multiplying the whole figure lets the inks sit on whatever field is under it. */
    mix-blend-mode: multiply;
  }

  .spark-static {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: opacity 600ms var(--ease-out);
  }

  .plate {
    mix-blend-mode: multiply;
  }

  .spark :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    mix-blend-mode: multiply;
    opacity: 0;
    transition: opacity 700ms var(--ease-out);
  }

  .spark:global(.is-live) :global(canvas) {
    opacity: 1;
  }

  .spark:global(.is-live) .spark-static {
    opacity: 0;
  }

  /* Pinned for most of a screen on desktop while the sheet feeds into the drum. */
  @media (min-width: 761px) and (prefers-reduced-motion: no-preference) {
    .hero {
      height: calc(175svh - 72px);
    }

    .stage {
      position: sticky;
      top: 72px;
    }
  }

  /* The masked headline: each line rises from behind its own baseline on load. */
  @media (prefers-reduced-motion: no-preference) {
    .line > span {
      animation: rise-line 900ms var(--ease-out) backwards;
      animation-delay: calc(120ms + var(--i) * 110ms);
    }

    .lede {
      animation: fade-up 700ms var(--ease-out) 520ms backwards;
    }
  }

  @keyframes rise-line {
    from {
      transform: translateY(105%);
    }
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  @media (max-width: 760px) {
    .hero {
      --seam-start: 46%;
    }

    .stage {
      height: calc(100svh - 60px);
      min-height: 520px;
    }

    .head {
      font-size: 15.5vw;
    }

    :lang(ja) .head {
      font-size: 13.5vw;
    }

    .lede {
      --head-size: 15.5vw;
      top: calc(var(--seam-start) + var(--head-size) * var(--head-foot) + 32px);
      font-size: var(--step-body);
      right: var(--gutter);
    }

    :lang(ja) .lede {
      --head-size: 13.5vw;
    }

    .spark {
      top: 3%;
      width: 46vw;
    }
  }
</style>
