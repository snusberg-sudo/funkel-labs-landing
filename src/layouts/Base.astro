---
import '@fontsource-variable/literata/opsz.css';
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import { contactEmail, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path of this page without the language prefix, e.g. "/" or "/privacy/". */
  path: string;
}

const { lang, title, description, path } = Astro.props;
const site = Astro.site ?? new URL('https://www.funkellabs.com');
const enUrl = new URL(path, site).href;
const jaUrl = new URL(`/ja${path}`, site).href;
const canonical = lang === 'ja' ? jaUrl : enUrl;
const ogImage = new URL('/og.png', site).href;
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Funkel Labs',
  alternateName: 'フンケル・ラボ',
  url: new URL('/', site).href,
  logo: new URL('/apple-touch-icon.png', site).href,
  email: contactEmail,
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="ja" href={jaUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/cabinet-grotesk-800.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#f9f8fb" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Funkel Labs" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'ja' ? 'ja_JP' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'ja' ? 'en_US' : 'ja_JP'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Funkel Labs: software that sparks" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
  </head>
  <body>
    <slot />
    <Analytics />
  </body>
</html>
